# ==== Base de datos ====
DATABASE_URL=postgresql://stop:stop@localhost:5432/escuelastop

# ==== Backend / API ====
PORT=3001
# Origen(es) permitido(s) para el dashboard (CORS). Admite varios separados por
# coma, p.ej.: https://escuelastop.pymesenlinea.com.ar,http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:3000
# URL pública del backend
PUBLIC_BASE_URL=http://localhost:3001
# Base pública del formulario (el agente arma el link del formulario con esto)
FORM_BASE_URL=http://localhost:3000

# ==== Autenticación del dashboard ====
# Secreto para firmar los tokens de sesión (usar uno largo y aleatorio en producción)
JWT_SECRET=dev-secret-cambiar-en-produccion
# Duración del token de sesión en horas
JWT_TTL_HOURS=12
# Credenciales del primer usuario admin (para `npm run seed:admin`)
ADMIN_EMAIL=admin@escuelastop.com.ar
ADMIN_PASSWORD=
# Rol del usuario semilla: admin (ve todas las sucursales) u operador. Por defecto admin.
ADMIN_ROLE=admin
# Sucursal del usuario semilla si es operador (nombre exacto, ej: Casa Central). El
# admin no lleva sucursal. Los demás usuarios se crean desde el panel (Usuarios).
ADMIN_SUCURSAL=

# ==== Anthropic (agente Claude) ====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ==== Mail (notificaciones al alumno por SMTP) ====
# NOTA: el SMTP y las credenciales del agente de IA también se pueden cargar desde
# el panel (pestaña Configuración, solo admin). Lo cargado ahí TIENE PRIORIDAD
# sobre estas variables, así la empresa configura todo sin tocar el .env.
# Opcional: si SMTP_HOST queda vacío (acá y en el panel), los mails se desactivan
# (no-op) y las notificaciones se mandan solo por WhatsApp. Ej. típico (Gmail/otros):
SMTP_HOST=
SMTP_PORT=587
# secure: true para 465 (SSL), false para 587/25 (STARTTLS). Si se omite, se
# autodetecta por el puerto.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente visible para el alumno. Si falta, usa SMTP_USER.
MAIL_FROM=Escuela STOP <no-reply@escuelastop.com.ar>

# ==== Pagos (seña de reserva) ====
# 'mercadopago' en producción; 'mock' aprueba al instante (solo desarrollo)
PAYMENT_PROVIDER=mock
# Access Token de Mercado Pago (Credenciales > Producción/Prueba en el panel de MP)
MP_ACCESS_TOKEN=

# ==== WhatsApp (Baileys) ====
# false = el canal se vincula a mano desde el panel (pestaña WhatsApp).
# true  = además intenta conectarse al arrancar reusando las credenciales
#         guardadas en el volumen wa_session (recomendado una vez vinculado).
WA_ENABLED=false
# Nivel de log de Baileys: silent (default) | error | warn | info | debug.
# Subilo solo para diagnosticar: la librería emite mucho ruido no accionable.
WA_LOG_LEVEL=silent

# ==== Dashboard ====
# (packages/dashboard/.env.local en dev; build-arg en Docker)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==== Docker / docker-compose ====
# Credenciales de Postgres del contenedor (deben coincidir con DATABASE_URL)
POSTGRES_USER=stop
POSTGRES_PASSWORD=stop
POSTGRES_DB=escuelastop
# Para usar imágenes publicadas en GHCR en vez de construir localmente:
# REGISTRY=ghcr.io/pel-matiasvaldivia/escuelastop
# IMAGE_TAG=latest
